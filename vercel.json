{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",

  "regions": ["gru1"],

  "headers": [
    {
      "source": "/_next/image",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ],

  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.armio.co" }],
      "destination": "https://armio.co/$1",
      "permanent": true
    }
  ]
}
