# URL pública de la app (donde están /terminos y /privacidad), sin barra final. Ej: https://app.armio.co
NEXT_PUBLIC_APP_URL=

# Google Analytics 4
# Obtén tu ID en https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend API Key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# Railway PostgreSQL URL
DATABASE_URL=postgresql://postgres:password@host:port/railway

# Email remitente (debe estar verificado en Resend)
RESEND_FROM=hola@armio.co

# URL pública del sitio (sin trailing slash)
NEXT_PUBLIC_SITE_URL=https://armio.co

# Habilitar landing page (true/false)
NEXT_PUBLIC_LANDING_ENABLED=true

# ── Portal público (/p/{slug}) ──
# URL base del API de Armio (incluye /api/v1). Solo servidor. Si falta, usa NEXT_PUBLIC_API_URL y luego https://api.armio.co/api/v1
PORTAL_API_URL=http://localhost:4000/api/v1
# Secreto compartido con el API (PORTAL_SERVER_KEY del API). SOLO servidor: nunca con prefijo NEXT_PUBLIC_
PORTAL_SERVER_KEY=

# ── Subdominios del portal ({slug}.armio.co) ──
# Dominio raíz de los portales (sin protocolo). Default: armio.co. En local: localhost:3000
# (los portales quedan en http://{slug}.localhost:3000). /p/{slug} es solo una ruta interna.
NEXT_PUBLIC_PORTAL_ROOT_DOMAIN=armio.co

# Revalidación inmediata: el API avisa a la landing cuando cambia algo del portal.
# Mismo valor que PORTAL_REVALIDATE_SECRET del API (mínimo 32 caracteres; openssl rand -hex 32). SOLO servidor, solo entorno Production.
PORTAL_REVALIDATE_SECRET=

# Cloudflare Turnstile (anti-bots del formulario del portal). Site key PÚBLICA por diseño.
# Vacía = el formulario funciona como antes y nunca se contacta a challenges.cloudflare.com.
# Solo Vercel Production. Se incrusta en el build: cambiarla exige redeploy. El secret va en el API (TURNSTILE_SECRET_KEY).
# En local usa la site key de prueba de Cloudflare: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
